<Window x:Class="WindowsAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeviceSync Local Sync Agent" Icon="app.ico" Height="680" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#CDD6F4"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B4BEFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Connection Status -->
            <RowDefinition Height="Auto"/> <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Active Progress Card -->
            <RowDefinition Height="*"/>    <!-- Tab Content (Lists) -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                <Image Source="app_logo.png" Stretch="Uniform"/>
            </Border>
            <StackPanel>
                <TextBlock Text="DeviceSync" FontSize="20" FontWeight="Bold" Foreground="#CDD6F4"/>
                <TextBlock Text="Windows ↔ Android Seamless Sync" FontSize="11" Foreground="#6C7086"/>
            </StackPanel>
        </StackPanel>

        <!-- Connection Status -->
        <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Fill="#F38BA8"/>
                    <TextBlock x:Name="StatusText" Text="Waiting for hotspot..." 
                               FontSize="13" FontWeight="SemiBold" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="DetailText" Text="Connect to phone's hotspot to begin" 
                           FontSize="11" Foreground="#6C7086" Margin="18,3,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="18,6,0,0">
                    <TextBlock x:Name="EncryptionStatusIcon" Text="🔒" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="EncryptionStatusText" Text="Not connected" 
                               FontSize="11" Foreground="#6C7086" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mode Switcher Tabs -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TabClipboardBtn" Grid.Column="0" Content="📋 Clipboard" Margin="0,0,4,0" 
                    Style="{StaticResource TabBtn}" Background="#45475A" Click="OnTabClipboardClicked"/>
            <Button x:Name="TabTransfersBtn" Grid.Column="1" Content="📁 Transfers" Margin="4,0,0,0" 
                    Style="{StaticResource TabBtn}" Background="#313244" Click="OnTabTransfersClicked"/>
        </Grid>

        <!-- Active Transfers Panel (replaces single ProgressCard) -->
        <Border x:Name="ActiveTransfersPanel" Grid.Row="3" Background="#313244" CornerRadius="8" Padding="8" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⚡ Active Transfers" FontSize="11" FontWeight="SemiBold" Foreground="#A6ADC8" Margin="2,0,0,4"/>
                <ListView x:Name="ActiveTransfersList" Background="Transparent" BorderThickness="0"
                          MaxHeight="140" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#45475A" CornerRadius="6" Padding="8,6" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DirectionIcon}" FontSize="14" FontWeight="Bold"
                                               Foreground="#CBA6F7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#CDD6F4" TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,3,0,0">
                                            <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                         Value="{Binding Progress}"
                                                         Foreground="#CBA6F7" Background="#1E1E2E" BorderThickness="0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="9"
                                                   Foreground="#6C7086" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusDisplay}" FontSize="11"
                                               Foreground="#A6E3A1" VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Grid.Column="3" Content="✕" FontSize="10" Padding="4,2"
                                            Background="Transparent" BorderThickness="0" Foreground="#6C7086"
                                            Cursor="Hand" VerticalAlignment="Center"
                                            Click="OnCancelTransferClicked"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Tab Content Area -->
        <Grid Grid.Row="4">
            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- CLIPBOARD VIEW                                              -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid x:Name="ClipboardView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Quick Send Controls -->
                    <RowDefinition Height="Auto"/> <!-- Section Header -->
                    <RowDefinition Height="*"/>    <!-- Clipboard List -->
                </Grid.RowDefinitions>

                <!-- Quick Send Controls -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button x:Name="SendCurrentClipboardBtn" Content="📋 Send Windows Clipboard to Phone" 
                            Style="{StaticResource ActionBtn}" Background="#CBA6F7" Foreground="#1E1E2E"
                            Click="OnSendCurrentClipboardClicked"/>

                    <Border Margin="0,8,0,0" Background="#313244" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManualClipboardInput" Grid.Column="0" 
                                     Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1" 
                                     Padding="8,6" FontSize="12" VerticalAlignment="Center"
                                     ToolTip="Type or paste any text to send to phone"
                                     KeyDown="OnManualClipboardInputKeyDown"/>
                            <Button x:Name="ManualClipboardSendBtn" Grid.Column="1" Content="Send ⚡" 
                                    Style="{StaticResource SmallBtn}" Background="#A6E3A1" Foreground="#1E1E2E" FontWeight="SemiBold"
                                    Margin="6,0,0,0" Padding="12,6" Click="OnManualClipboardSendClicked"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="📋 Clipboard Journal (click to re-send to phone)" 
                           FontSize="12" Foreground="#A6ADC8" Margin="2,0,0,6"/>

                <Border Grid.Row="2" Background="#313244" CornerRadius="8" Padding="4">
                    <ListBox x:Name="ClipboardList" Background="Transparent" BorderThickness="0"
                             Foreground="#CDD6F4" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnClipboardItemDoubleClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#45475A" CornerRadius="6" Padding="10,8" Margin="2" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis" 
                                                       MaxHeight="40" Foreground="#CDD6F4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#89B4FA"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="#6C7086"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Send ↗" FontSize="10" Foreground="#CBA6F7" 
                                                   VerticalAlignment="Center" Margin="6,0,2,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- FILE TRANSFERS VIEW                                         -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid x:Name="TransfersView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Send Actions & Drop Zone -->
                    <RowDefinition Height="Auto"/> <!-- Storage Path Settings -->
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Transfers List -->
                </Grid.RowDefinitions>

                <!-- Send Actions & Drop Area -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="📤 Select &amp; Send Files (Photos, Videos, Docs)" Style="{StaticResource ActionBtn}" 
                            Click="OnSelectFilesClicked"/>

                    <!-- Drag & Drop Zone Box -->
                    <Border Margin="0,8,0,0" Background="#313244" BorderBrush="#45475A" BorderThickness="1.5" 
                            CornerRadius="8" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📥 Drag &amp; Drop files here to beam to Android" 
                                       FontSize="12" Foreground="#BAC2DE" HorizontalAlignment="Center"/>
                            <TextBlock Text="Any photo, 4K video, PDF, or folder" 
                                       FontSize="10" Foreground="#6C7086" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Storage Location Card -->
                <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="📁 Save Location:" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Change..." Style="{StaticResource SmallBtn}" Click="OnChangeDownloadFolderClicked" Margin="0,0,6,0"/>
                                <Button Content="Open Folder" Style="{StaticResource SmallBtn}" Click="OnOpenDownloadFolderClicked"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="DownloadPathText" Grid.Row="1" Text="C:\Users\...\Downloads\SyncDevice" 
                                   FontSize="11" Foreground="#89B4FA" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- Transfer History Section Header -->
                <Grid Grid.Row="2" Margin="2,0,0,6">
                    <TextBlock Text="📁 Transfer History" FontSize="12" Foreground="#A6ADC8" HorizontalAlignment="Left"/>
                    <Button x:Name="SendToMenuBtn" Content="⚡ Add to Right-Click Menu" Style="{StaticResource SmallBtn}" 
                            HorizontalAlignment="Right" Click="OnRegisterSendToClicked"/>
                </Grid>

                <!-- Transfers List -->
                <Border Grid.Row="3" Background="#313244" CornerRadius="8" Padding="4">
                    <ListBox x:Name="TransfersList" Background="Transparent" BorderThickness="0"
                             Foreground="#CDD6F4" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnTransferItemDoubleClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#45475A" CornerRadius="6" Padding="10,8" Margin="2" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding IconText}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" 
                                                       FontWeight="SemiBold" Foreground="#CDD6F4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding DirectionDisplay}" FontSize="10" Foreground="{Binding DirectionColor}"
                                                           FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#A6ADC8" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TimeDisplay}" FontSize="10" Foreground="#6C7086"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="Open ↗" FontSize="10" Foreground="#CBA6F7" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- Drop Overlay (Appears during DragOver) -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#EE1E1E2E" 
                CornerRadius="12" BorderBrush="#CBA6F7" BorderThickness="2" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✨" FontSize="42" HorizontalAlignment="Center"/>
                <TextBlock Text="Drop files to send to Android" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Supports photos, videos, and all documents" FontSize="12" Foreground="#A6ADC8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock x:Name="FooterText" Text="Scanning for Android agent on port 7777..." 
                       FontSize="10" Foreground="#585B70" VerticalAlignment="Center"/>
            <TextBlock Text=" · " FontSize="10" Foreground="#45475A" VerticalAlignment="Center"/>
            <Button x:Name="DirectIpButton" Content="Direct IP" Click="DirectIpButton_Click"
                    Background="Transparent" BorderThickness="0" Foreground="#89B4FA" FontSize="10"
                    Cursor="Hand" Padding="2,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Direct IP Dialog Overlay -->
        <Border x:Name="DirectIpOverlay" Grid.Row="0" Grid.RowSpan="6" Background="#CC11111B" 
                CornerRadius="12" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="340" Background="#1E1E2E" CornerRadius="12" Padding="20"
                    BorderBrush="#313244" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Connect to Android Device" FontSize="15" FontWeight="Bold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Enter the IP address shown on your Android app or notification:" 
                               FontSize="11" Foreground="#A6ADC8" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    
                    <TextBox x:Name="DirectIpInput" Background="#181825" Foreground="#CDD6F4" 
                             BorderBrush="#45475A" BorderThickness="1" Padding="8,6" FontSize="13" Margin="0,0,0,14"
                             KeyDown="DirectIpInput_KeyDown"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="DirectIpCancel_Click" Width="80" Height="30"
                                Background="Transparent" Foreground="#A6ADC8" BorderBrush="#45475A" BorderThickness="1"
                                Margin="0,0,8,0" Cursor="Hand"/>
                        <Button x:Name="DirectIpConnectButton" Content="Connect" Click="DirectIpConnect_Click" Width="80" Height="30"
                                Background="#89B4FA" Foreground="#11111B" FontWeight="SemiBold" BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
